#!/usr/bin/env bash
# Clears the Sidequest plugin's saved state (device key, pending code, auto-connect flag)
# so the next Claude Code session runs like a fresh install. Quit Claude Code first.
set -euo pipefail

store="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/store"
shopt -s nullglob
files=("$store"/sidequest_*.json)

if [ ${#files[@]} -eq 0 ]; then
  echo "No Sidequest plugin state in $store."
  exit 0
fi
rm -- "${files[@]}"
printf 'Removed %s\n' "${files[@]}"
