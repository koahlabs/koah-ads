# Server only. Never use NEXT_PUBLIC_ for these values.
LOOPS_API_KEY=
LOOPS_WAITLIST_TRANSACTIONAL_ID=
# Used by loops:auth-setup only. Supabase sends auth mail through Loops SMTP.
LOOPS_AUTH_TRANSACTIONAL_ID=
# Optional existing Loops mailing list. Otherwise segment by muxWaitlistJoinedAt.
LOOPS_WAITLIST_MAILING_LIST_ID=
# Sender local part on the verified Loops domain, e.g. hello.
LOOPS_FROM_EMAIL=
# Server-only incoming webhook bound to #koah-info. Never use NEXT_PUBLIC_.
SETTINGS__KOAH_INFO_SLACK_URL=
# Public production URL, used for social sharing. Vercel URLs work automatically.
NEXT_PUBLIC_SITE_URL=

# Supabase Auth: synced by the Vercel Marketplace connection. Only public keys are used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older integrations may provide NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Configure the Google client ID and secret in Supabase, not in this file.

# Vercel Flags uses Vercel OIDC on deployments. Pull credentials locally with
# vercel env pull. Keep VERCEL_OIDC_TOKEN server-only and do not commit it.

# Dashboard, waitlist lead numbers, and Stripe Connect. Keep every value below server-only.
# Apply supabase/migrations/202610130001_dashboard.sql before enabling payouts.
# Supabase sb_secret_ key, used to persist Stripe mappings and assign waitlist lead numbers.
# Apply 202610130002_waitlist_lead_numbers.sql and import the existing Loops waitlist
# with npm run slack:seed-leads -- /path/to/export.csv before enabling lead numbers.
SUPABASE_SECRET_KEY=
# Prefer a Stripe restricted key with account, account-link, and login-link permissions.
# Use a separate sandbox for development. Production requires a live key.
STRIPE_CONNECT_KEY=
# A unique namespace per Stripe sandbox/platform, e.g. development-sandbox or live.
STRIPE_CONNECT_ENVIRONMENT=
# Comma-separated recipient countries enabled for your Connect platform, e.g. US,CA.
STRIPE_CONNECT_COUNTRIES=
