# Server only. Never use NEXT_PUBLIC_ for these values.
LOOPS_API_KEY=
LOOPS_WAITLIST_TRANSACTIONAL_ID=
# Used by loops:auth-setup only. Supabase sends auth mail through Loops SMTP.
LOOPS_AUTH_TRANSACTIONAL_ID=
# Optional existing Loops mailing list. Otherwise segment by muxWaitlistJoinedAt.
LOOPS_WAITLIST_MAILING_LIST_ID=
# Sender local part on the verified Loops domain, e.g. hello.
LOOPS_FROM_EMAIL=
# Server-only incoming webhook bound to #koah-info. Never use NEXT_PUBLIC_.
SETTINGS__KOAH_INFO_SLACK_URL=
# Public production URL, used for social sharing. Vercel URLs work automatically.
NEXT_PUBLIC_SITE_URL=

# Supabase Auth: synced by the Vercel Marketplace connection. Only public keys are used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older integrations may provide NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Vercel Flags uses Vercel OIDC on deployments. For local setup, see the root README.
# Local only: a Vercel Flags SDK key for the Development environment.
FLAGS=

# Server only. Use a Supabase secret key (sb_secret_...). It serves the Sidequest ad proxy,
# Stripe connections, and waitlist lead numbers.
SUPABASE_SECRET_KEY=
# Koah serving token and publisher ID for the S2S API.
KOAH_SERVING_TOKEN=
KOAH_PUBLISHER_ID=
# Optional. Defaults to https://app.koah.ai.
# KOAH_API_URL=

# Dashboard and Stripe Connect. Server only.
# Prefer a restricted key with Accounts v2, account link, account read, and login link permissions.
# Use a sandbox key in development. Production accepts only live keys.
STRIPE_CONNECT_KEY=
# Comma-separated recipient countries enabled on the Connect platform, for example US,CA.
STRIPE_CONNECT_COUNTRIES=

# Optional. Only for deployments protected by Vercel Authentication or a password. The analytics SDK reads it.
# VERCEL_AUTOMATION_BYPASS_SECRET=
